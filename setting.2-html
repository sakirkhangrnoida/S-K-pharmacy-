    <script>
        function showTab(index) {
            document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('active'));
            document.querySelectorAll('.content-box').forEach(box => box.classList.remove('active'));

            document.querySelectorAll('.menu-item')[index].classList.add('active');
            document.querySelectorAll('.content-box')[index].classList.add('active');

            if(window.innerWidth < 768) {
                document.querySelector('.settings-content').scrollIntoView({behavior: 'smooth'});
            }
        }

        // Auto-open tab from URL hash
        window.onload = function() {
            const hash = window.location.hash.substring(1);
            const tabs = ['orders','shipping','returns','privacy','terms','team','help','contact','account'];
            const index = tabs.indexOf(hash);
            if(index >= 0) showTab(index);

            // Load order tracking
            const lastOrder = localStorage.getItem('grnoida_last_order');
            if(lastOrder) {
                document.getElementById('tracking').style.display = 'block';
                const order = JSON.parse(lastOrder);
                document.getElementById('orderDetails').innerHTML = `
                    <b>Order ID:</b> ${order.orderId}<br>
                    <b>Name:</b> ${order.name} | <b>Mobile:</b> ${order.mobile}<br>
                    <b>Total:</b> ₹${order.total} | ${order.payment}<br>
                                        <b>Address:</b> ${order.address}, ${order.pin}
                `;
                const statusMap = {'Order Placed':1, 'Packed':2, 'Shipped':3, 'Delivered':4};
                const step = statusMap[order.status] || 1;
                document.getElementById('progress').style.width = (step-1)*33.33 + '%';
                document.getElementById('currentStatus').innerText = 'Current Status: ' + order.status;
                for(let i=1;i<=4;i++){
                    document.getElementById('s'+i).style.background = i<=step? '#ff9900' : '#ddd';
                }
            }
        }
    </script>
